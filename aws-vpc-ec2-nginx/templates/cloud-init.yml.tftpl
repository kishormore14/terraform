#cloud-config
package_update: true
package_upgrade: true

packages:
  - nginx

services:
  enabled:
    - nginx
  started:
    - nginx

write_files:
  - path: /usr/share/nginx/html/index.html
    content: |
      <!DOCTYPE html>
      <html>
      <head>
          <title>Welcome to Nginx</title>
          <style>
              body { font-family: sans-serif; text-align: center; padding-top: 50px; background-color: #0f172a; color: #f8fafc; }
              h1 { color: #38bdf8; }
          </style>
      </head>
      <body>
          <h1>Nginx Web Server</h1>
          <p>Provisioned successfully via Cloud-Init & Terraform</p>
      </body>
      </html>
    permissions: '0644'
